<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The real theming (colors, typography) lives in ui/theme/Theme.kt (Compose).
         This XML theme only sets what Android needs before Compose takes over:
         window background and the system bars, so there's no flash of the wrong color. -->
    <style name="Theme.GeoAlarm" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>

    <!-- Shown over the lock screen for the ringing alarm; no status/nav bar chrome needed. -->
    <style name="Theme.GeoAlarm.Alarm" parent="Theme.GeoAlarm">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
