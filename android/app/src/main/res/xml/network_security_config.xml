<?xml version="1.0" encoding="utf-8"?>
<!-- No exceptions: every request GeoAlarm makes (tiles, geocoding, backend) uses HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
