<?xml version="1.0" encoding="utf-8"?>
<!--
  allowBackup is false in the manifest, so this mainly documents intent and covers
  device-transfer ("D2D") migration, which is governed separately from cloud backup.
  Alarms, saved places and history are considered sensitive location data and are
  excluded from any transfer mechanism by default.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
