# GeoAlarm backend configuration.
# Copy to `.env` for local development. NEVER commit the real .env file.
# On Render, set these as environment variables in the dashboard instead
# (see docs/render-deployment.md).

# "development" or "production". Production disables the interactive API docs.
GEOALARM_ENV=development

# Comma-separated list of exact origins allowed to call the API from a browser.
# Example: https://YOUR-USER.github.io
# Leave empty to allow no cross-origin browser calls. "*" is only honoured in development.
GEOALARM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Public URL of the release APK (GitHub Releases asset URL). Empty = "not published yet".
GEOALARM_APK_URL=

# Optional SHA-256 checksum of the published APK.
GEOALARM_APK_SHA256=

# Optional override of release-metadata.json fields (normally leave empty).
GEOALARM_RELEASE_DATE=
GEOALARM_MIN_ANDROID=

# Log level: DEBUG, INFO, WARNING, ERROR
GEOALARM_LOG_LEVEL=INFO

# ---- Reserved for future features (not used by v1.0.0) ----
# DATABASE_URL=postgresql://user:password@host:5432/geoalarm
# JWT_SECRET=change-me
